{
  "name": "fpl-pilot",
  "version": "1.0.0",
  "description": "Explainable Fantasy Premier League Assistant",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "node ./node_modules/concurrently/dist/bin/concurrently.js \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node ./node_modules/tsx/dist/cli.mjs watch src/server.ts",
    "dev:client": "node ./node_modules/vite/bin/vite.js",
    "build": "npm run build:client && npm run build:server",
    "build:client": "node ./node_modules/vite/bin/vite.js build",
    "build:server": "node ./node_modules/typescript/bin/tsc --project tsconfig.server.json",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
    "test": "npm run typecheck && npm run test:unit && npm run test:live",
    "test:unit": "node ./node_modules/tsx/dist/cli.mjs --test test/engine.test.ts test/bundle.test.ts",
    "test:live": "node ./node_modules/tsx/dist/cli.mjs test/proxy.live.ts",
    "check": "npm run test && npm run build",
    "start": "node server-dist/local-server.js",
    "preview": "node ./node_modules/vite/bin/vite.js preview"
  },
  "dependencies": {
    "express": "^4.18.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^4.4.1",
    "html2canvas": "^1.4.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/node": "^20.3.1",
    "@types/react": "^18.2.14",
    "@types/react-dom": "^18.2.6",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.14",
    "concurrently": "^8.2.0",
    "esbuild": "^0.18.20",
    "postcss": "^8.4.24",
    "tailwindcss": "^3.3.2",
    "tsx": "^3.12.7",
    "typescript": "^5.1.3",
    "vite": "^4.4.0"
  }
}
