{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "./dist",
    "tsBuildInfoFile": "./dist/tsconfig.server.tsbuildinfo",
    "rootDir": "./src",
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "module": "ES2020",
    "target": "ES2020"
  },
  "include": ["src/server.ts", "src/proxy.ts"],
  "exclude": ["src/client"]
}