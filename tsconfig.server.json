{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "./server-dist",
    "tsBuildInfoFile": "./server-dist/tsconfig.server.tsbuildinfo",
    "rootDir": ".",
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "module": "ES2020",
    "target": "ES2020"
  },
  "include": ["src/local-server.ts", "api/index.ts"],
  "exclude": ["src/client"]
}